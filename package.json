{
  "name": "@anil-labs/validator",
  "version": "0.1.0",
  "description": "An expressive, strictly-typed validation library for TypeScript — framework-agnostic core plus a chainable Quasar/Vue rule builder.",
  "keywords": [
    "validation",
    "validator",
    "typescript",
    "vue",
    "quasar",
    "form",
    "rules",
    "schema"
  ],
  "license": "MIT",
  "homepage": "https://github.com/anilkumarthakur60/validator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/validator.git"
  },
  "bugs": {
    "url": "https://github.com/anilkumarthakur60/validator/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:typecheck": "vue-tsc --noEmit -p demo/tsconfig.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "coverage": "vitest run --coverage --config vitest.config.ts",
    "check:exports": "publint && attw --pack .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:exports"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/language-core": "^3.3.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.12",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.7",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.2"
  }
}
